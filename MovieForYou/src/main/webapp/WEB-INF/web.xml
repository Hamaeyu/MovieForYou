<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://jakarta.ee/xml/ns/jakartaee" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd" id="WebApp_ID" version="6.0">
  <display-name>MovieForYou</display-name>
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>
  <session-config>
    <session-timeout>20</session-timeout>
  </session-config>
  <filter>
    <filter-name>EncodingFilter</filter-name>
    <filter-class>kr.or.hamaeyu.filter.EncodingFilter</filter-class>
    <init-param>
      <param-name>encoding</param-name>
      <param-value>UTF-8</param-value>
    </init-param>
  </filter>
  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>kr.or.hamaeyu.filter.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>EncodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <servlet>
    <servlet-name>UploadCinemaImageServlet</servlet-name>
    <servlet-class>kr.or.hamaeyu.controller.UploadCinemaImageServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>UploadCinemaImageServlet</servlet-name>
    <url-pattern>/uploadImage.cinema</url-pattern>
  </servlet-mapping>
  <servlet>
    <description></description>
    <display-name>UploadCheckServlet</display-name>
    <servlet-name>UploadCheckServlet</servlet-name>
    <servlet-class>kr.or.hamaeyu.controller.UploadCheckServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>UploadCheckServlet</servlet-name>
    <url-pattern>/UploadCheckServlet</url-pattern>
  </servlet-mapping>
</web-app>