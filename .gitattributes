
# Text normalization (Line endings)

# 저장소 내부는 항상 LF 사용 (리눅스/맥 기준)
* text=auto eol=lf

# Windows용 실행 스크립트는 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf

# Linux/Mac 실행 스크립트는 LF
*.sh text eol=lf
mvnw text eol=lf
gradlew text eol=lf


# Java / JSP / Servlet 관련
*.java          text diff=java working-tree-encoding=UTF-8
*.properties    text working-tree-encoding=UTF-8
*.xml           text working-tree-encoding=UTF-8
*.tld           text working-tree-encoding=UTF-8
*.tag           text working-tree-encoding=UTF-8
*.tagx          text working-tree-encoding=UTF-8
*.jsp           text diff=html working-tree-encoding=UTF-8
*.jspf          text diff=html working-tree-encoding=UTF-8
*.jspx          text diff=html working-tree-encoding=UTF-8


# Frontend (HTML / CSS / JS)

*.html          text diff=html working-tree-encoding=UTF-8
*.htm           text diff=html working-tree-encoding=UTF-8
*.css           text diff=css working-tree-encoding=UTF-8
*.scss          text diff=css working-tree-encoding=UTF-8
*.js            text working-tree-encoding=UTF-8
*.json          text working-tree-encoding=UTF-8
*.vue           text working-tree-encoding=UTF-8
*.jsx           text working-tree-encoding=UTF-8
*.tsx           text working-tree-encoding=UTF-8

